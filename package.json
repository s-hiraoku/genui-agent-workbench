{
  "name": "genui-agent-workbench",
  "version": "0.1.0",
  "description": "Resident local GenUI popup broker for agent-generated OpenUI Lang.",
  "author": "GenUI Agent Workbench contributors",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && electron_config_cache=${electron_config_cache:-/private/tmp/electron-cache} electron dist-electron/electron/main.js",
    "electron:dmg": "npm run build && npm run electron:build && electron_config_cache=${electron_config_cache:-/private/tmp/electron-cache} ELECTRON_CACHE=${ELECTRON_CACHE:-/private/tmp/electron-cache} ELECTRON_BUILDER_CACHE=${ELECTRON_BUILDER_CACHE:-/private/tmp/electron-builder-cache} electron-builder --mac dmg --publish never",
    "electron:zip": "npm run build && npm run electron:build && electron_config_cache=${electron_config_cache:-/private/tmp/electron-cache} ELECTRON_CACHE=${ELECTRON_CACHE:-/private/tmp/electron-cache} ELECTRON_BUILDER_CACHE=${ELECTRON_BUILDER_CACHE:-/private/tmp/electron-builder-cache} electron-builder --mac zip --publish never",
    "electron:pack": "npm run electron:zip",
    "release:macos": "npm run electron:zip -- --arm64 && node scripts/package-macos-release.mjs",
    "genui": "tsx scripts/genui-cli.ts",
    "genui:mcp": "node scripts/genui-mcp-server.mjs",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint"
  },
  "build": {
    "appId": "dev.genui.agent-workbench",
    "productName": "GenUI Popup Broker",
    "files": [
      ".next/standalone/**/*",
      "dist-electron/**/*",
      "next.config.ts",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/static",
        "to": "app.asar.unpacked/.next/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "app.asar.unpacked/.next/standalone/public"
      }
    ],
    "asarUnpack": [
      ".next/standalone/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "backgroundColor": "#101820",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openuidev/react-headless": "latest",
    "@openuidev/react-lang": "latest",
    "@openuidev/react-ui": "latest",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "8.5.15",
    "refractor": {
      "prismjs": "1.30.0"
    }
  }
}
